{
  "name": "@ligis/circuits-zcash",
  "version": "0.1.0",
  "description": "Zecathon: Noir circuit proving a payee-bound Ligis credential (Poseidon Merkle membership + nullifier) against a published CredentialRegistry root without revealing the holder",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fields": {
      "import": "./dist/fields.js",
      "types": "./dist/fields.d.ts"
    },
    "./verify": {
      "import": "./dist/verify.js",
      "types": "./dist/verify.d.ts"
    },
    "./registry": {
      "import": "./dist/registry.js",
      "types": "./dist/registry.d.ts"
    },
    "./demo": {
      "import": "./dist/demo-registry.js",
      "types": "./dist/demo-registry.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:circuit": "cd circuit && nargo compile",
    "test": "pnpm run test:circuit && node --import tsx --test test/*.test.ts",
    "test:circuit": "cd circuit && nargo test",
    "prove:sample": "tsx scripts/prove-sample.ts",
    "clean": "rm -rf dist circuit/target",
    "write:vk": "tsx scripts/write-vk.ts",
    "build-root": "tsx scripts/build-root.ts",
    "fetch-crs": "bash scripts/fetch-crs.sh"
  },
  "toolchain": {
    "nargo": "1.0.0-beta.22",
    "bb": "5.0.0-nightly.20260522",
    "provingSystem": "UltraHonk (barretenberg)"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.0",
    "circomlibjs": "^0.1.7",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/circomlibjs": "^0.1.6",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
