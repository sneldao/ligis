# dependencies
/lib/
node_modules/
/packages/*/dist/
/packages/*/node_modules/
out/
cache/
broadcast/

# package build outputs
dist/

# typescript incremental build cache
*.tsbuildinfo

# envio HyperIndex codegen / local docker outputs
packages/envio-indexer/generated/
packages/envio-indexer/.envio/

# casper wasm build output
packages/contracts-casper/wasm/

# secrets — never commit these
.env
.env.local
.env.*.local
.env.d/
*.key
*.pem
*.p12
*.pfx
*.secret
secrets/
deployments/localhost/

# deployment records (contain live addresses + deployer info)
.deployment-latest.json

# editor
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# test artifacts
coverage/
coverage.json
lcov.info
gas-report.txt

# foundry debug
debug.log
.trace

# npm
.npm
.npmrc
package-lock.json
web/package-lock.json

# claude code / commandcode / agent session-local config
.claude/
.commandcode/
.junie/
.agents/
.casper/

# video projects — source tracked, rendered output + captures ignored
# Composition source (index.html, STORYBOARD.md, capture scripts, VO scripts)
# stays tracked so the repro is self-contained. Everything below is derived.
/video/*/ligis-demo.mp4
/video/*/renders/
/video/*/thumbs/
/video/*/assets/
/video/*/node_modules/
/video/*/package-lock.json
/videos/*/renders/
/videos/*/thumbs/
/videos/*/assets/
/videos/*/audio/
/videos/*/capture/
/videos/*/node_modules/
/videos/*/package-lock.json
# media binaries anywhere in a video project
/videos/**/*.png
/videos/**/*.jpg
/videos/**/*.jpeg
/videos/**/*.gif
/videos/**/*.svg
# ...but keep the small poster/thumbnail frames at the project root
!/videos/*/poster.jpg
!/videos/*/thumb.jpg

# all rendered video/audio output — never commit binaries
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.ogg
*.flac

# accidental build output of an earlier tsc run — not the real package
# (real one is packages/adapter-casper/); keep ignored unless user confirms
/CredentialRegistry/

# Stray TypeScript emit outside dist/ (e.g. from an accidental global tsc run)
/packages/*/src/**/*.js
/packages/*/src/**/*.js.map
/packages/*/src/**/*.d.ts
/packages/*/test/**/*.js
/packages/*/test/**/*.js.map
/packages/*/test/**/*.d.ts
/scripts/*.js
/scripts/*.js.map
/scripts/*.d.ts
/web/app/**/*.js
/web/app/**/*.js.map
/web/app/**/*.d.ts
/web/components/**/*.js
/web/components/**/*.js.map
/web/components/**/*.d.ts
/web/lib/**/*.js
/web/lib/**/*.js.map
/web/lib/**/*.d.ts

.pnpm-store/

# GenLayer Python artifacts
__pycache__/
*.pyc
*.pyo
/packages/contracts-genlayer/artifacts/
/packages/contracts-genlayer/.env

# Ad-hoc run captures from manual shell sessions (non-standard naming).
# Canonical receipts — scripts/*.lastrun.txt — stay committable as evidence.
/scripts/*-laun.txt

