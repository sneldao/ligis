{
  "name": "ligis",
  "version": "0.1.0",
  "description": "Ligis \u2014 Chain-agnostic Identity & Verifiable Credentials Skill for AI agents. Portable agent IDs, signed capability credentials, key rotation, and revocation. Pluggable chain adapters (EVM/Pharos today; Casper next), with 0G Compute for reasoning and 0G Storage for verifiable evidence.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter '!@ligis/contracts-casper' run build",
    "dev": "pnpm -r run dev",
    "start": "node --enable-source-maps packages/cli/dist/index.js",
    "mcp": "node --enable-source-maps packages/mcp-server/dist/index.js",
    "mcp:dev": "tsx packages/mcp-server/src/index.ts",
    "x402": "node --enable-source-maps packages/x402-server/dist/index.js",
    "x402:dev": "tsx watch packages/x402-server/src/index.ts",
    "croo": "node --enable-source-maps packages/croo-adapter/dist/src/cli/provider.js",
    "croo:dev": "tsx packages/croo-adapter/src/cli/provider.ts",
    "test": "bash scripts/forge.sh test -vvv",
    "test:ts": "node --import tsx --test packages/*/test/**/*.test.ts",
    "test:all": "bash scripts/forge.sh test -vvv && pnpm run test:ts",
    "audit:deps": "pnpm audit --audit-level high",
    "audit:deps:all": "pnpm audit",
    "audit:cargo": "cd packages/contracts-casper && cargo audit",
    "test:coverage": "bash scripts/forge.sh coverage",
    "deploy:atlantic": "bash scripts/deploy.sh atlantic",
    "verify:atlantic": "bash scripts/verify.sh atlantic",
    "setup:casper": "tsx scripts/setup-casper-wallets.ts",
    "derive-casper-wallets": "tsx scripts/derive-casper-wallet.ts",
    "smoke:casper": "tsx scripts/casper-smoke-test.ts",
    "demo:croo": "tsx scripts/croo-e2e-demo.ts",
    "demo:casper": "tsx scripts/casper-e2e-demo.ts",
    "demo:monid": "pnpm start -- agent run --goal 'pay a counterparty for premium RWA data' --counterparty '${MONID_COUNTERPARTY:-0x0000000000000000000000000000000000000000}'",
    "deploy:casper": "pnpm --filter @ligis/adapter-casper deploy",
    "demo": "bash scripts/demo.sh",
    "format": "bash scripts/forge.sh fmt && prettier --write 'packages/*/src/**/*.{ts,json,md}'",
    "clean": "pnpm -r run clean && rm -rf out cache broadcast"
  },
  "keywords": [
    "pharos",
    "agent",
    "skill",
    "identity",
    "credentials",
    "eip-712",
    "erc-721",
    "mcp",
    "ai-agent",
    "web3"
  ],
  "devDependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.7.0",
    "casper-js-sdk": "^5.0.12",
    "playwright": "^1.45.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "adm-zip": ">=0.6.0",
      "fast-uri": ">=4.1.2",
      "brace-expansion": ">=5.0.9",
      "@hono/node-server": ">=2.0.5",
      "hono": ">=4.12.34",
      "axios": ">=0.33.0",
      "next": ">=16.2.11",
      "postcss": ">=8.5.18",
      "ws": ">=8.21.0",
      "elliptic": ">=6.6.1",
      "ip-address": ">=10.3.1",
      "nanoid": ">=3.3.18"
    }
  }
}
