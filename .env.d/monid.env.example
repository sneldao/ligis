# Monid (https://monid.ai) — agent-native API discovery + per-call metering.
# Copy to .env.d/monid.env and fill in the values from the Monid dashboard.

MONID_API_KEY=monid_...

# Demo scripts: counterparty address to run the trust check against.
# MONID_COUNTERPARTY=0x...

# Optional overrides for the risk provider:
# MONID_BASE_URL=https://api.monid.ai
# MONID_RISK_QUERY=counterparty risk for a crypto wallet
# MONID_RISK_PROVIDER=          # skip discovery ranking, use this provider
# MONID_RISK_ENDPOINT=          # skip discovery ranking, use this endpoint
# MONID_RISK_INPUT_FIELD=address
