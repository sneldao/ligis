# Jev intent-layer credentials for the x402 Trust Gate (@ligis/core
# packages/core/src/jev.ts). Copy to typesafe.env and fill in.
#
# .env.d/ is gitignored; only *.env.example files are tracked. Never commit.
# Load with:  set -a; source .env.d/typesafe.env; set +a
#
# Pick a PRIMARY route; LIGIS_JEV_TRANSPORT=auto resolves gateway > direct
# > gateway (novita-vl is explicit-only — auto never picks it). Routes can
# also chain: LIGIS_JEV_FALLBACK is a comma-separated list of route names
# tried in order when the primary fails.

# Route 1 — TypeSafe direct (what production has run since 2026-10-18).
# https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Route 2 — Vercel AI Gateway. Its free window ended 2026-09-25, so this needs
# billing/BYOK attached. https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY=

# Route 3 — novita-vl: AutoTrust JEV-27B-VL via Novita AI
# (POST /v3/autotrust/v1/decide). Partner promo: FREE ~14 days from
# 2026-10-19 (through ~2026-11-02), then metered — input tokens only, no
# published unit price. Different protocol: ONE question per request, so
# the route fans the gate's four trust questions out to four parallel
# requests under the same overall deadline.
# https://platform.novita.ai/keys
#
# When the promo ends without balance Novita returns 403 NOT_ENOUGH_BALANCE /
# NOT_ENOUGH_KEY_BUDGET / NOT_ENOUGH_MEMBER_BUDGET; 401/403/429 arm a 60s
# route cooldown and the chain falls through — never an error, never a block.
# NOVITA_API_KEY=          # or LIGIS_JEV_NOVITA_API_KEY (takes precedence)
# LIGIS_JEV_NOVITA_API_URL=https://api.novita.ai/v3/autotrust/v1/decide
# LIGIS_JEV_NOVITA_MODEL=autotrust/jev-27b-vl
# Novita publishes no unit price — when unset, costUsd is reported as null:
# LIGIS_JEV_NOVITA_INPUT_USD_PER_MTOK=

# Fallback chain — comma-separated route names tried after the primary,
# each built from its own credential above. Two example configs:
#   (a) promo-first:  LIGIS_JEV_TRANSPORT=novita-vl + LIGIS_JEV_FALLBACK=direct
#   (b) conservative: LIGIS_JEV_TRANSPORT=direct   + LIGIS_JEV_FALLBACK=novita-vl
# LIGIS_JEV_FALLBACK=direct
